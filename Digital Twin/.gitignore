# ── Secrets & credentials ──────────────────────────────────────────
# NEVER commit this file. It is already in .gitignore.
.dev.vars

# ── Wrangler build artifacts ───────────────────────────────────────
.wrangler/
_worker.bundle

# ── OS metadata ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Node.js ───────────────────────────────────────────────────────
node_modules/

# ── Build output (generated by tools/build-dist.cjs) ─────────────
dist/

# ── Source backups (development artifacts) ────────────────────────
*.bak
*.bak[0-9]

# ── Private backup of functions pre-hardening ─────────────────────
functions/_backup/

# ── Dev capture logs ──────────────────────────────────────────────
browser_console.log
*.log
